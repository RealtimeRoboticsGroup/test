[access]
	inheritFrom = All-Projects
[label "Verified"]
        defaultValue = 0
        value = -1 Fails
        value = 0 No score
        value = +1 Verified
        copyCondition = changekind:NO_CHANGE
[submit-requirement "Verified"]
        description = At least one maximum vote for label 'Verified' is required
        submittableIf = label:Verified=MAX,user=non_uploader AND -label:Verified=MIN
        canOverrideInChildProjects = true
[receive]
        enableSignedPush = true
[submit]
[access "refs/*"]
	owner = group user/Austin Schuh (AustinSchuh)
[access "refs/for/refs/*"]
	label-Code-Review = -2..+2 group user/Austin Schuh (AustinSchuh)
	label-Verified = -1..+1 group user/Austin Schuh (AustinSchuh)
	push = group user/Austin Schuh (AustinSchuh)
	read = group user/Austin Schuh (AustinSchuh)
	rebase = group user/Austin Schuh (AustinSchuh)
	removeReviewer = group user/Austin Schuh (AustinSchuh)
	submit = group user/Austin Schuh (AustinSchuh)
[access "refs/heads/*"]
	create = group user/Austin Schuh (AustinSchuh)
	push = +force group user/Austin Schuh (AustinSchuh)
	pushMerge = group user/Austin Schuh (AustinSchuh)
	read = group user/Austin Schuh (AustinSchuh)
        exclusiveGroupPermissions = submit
[access "refs/tags/*"]
	push = group user/Austin Schuh (AustinSchuh)
	push = +force group user/Austin Schuh (AustinSchuh)
